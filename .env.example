# =========================
# App / Segurança (backend)
# =========================
APP_ENV=dev
SERVER_PORT=8080
HMAC_SECRET=
FRONTEND_URL=http://localhost:8081
VERIFICATION_CHANNEL=DUMMY
ADMIN_SESSION_TTL_DAYS=7
ADMIN_BOOKING_ACTIVE_PAST_DAYS=10
ADMIN_BOOKING_MAX_FUTURE_MONTHS_AHEAD=6
APP_HISTORY_RETENTION_MONTHS=2.0
# Fallback sem Supabase: telefone|nome|OWNER;telefone|nome|PROVIDER
# Telefones BR sao normalizados; aceita 31995438467, 5531995438467, +55 (31) 99543-8467 e variacoes com espacos/pontuacao.
ADMIN_USERS=31995438467|SG Admin|OWNER

# =========================
# Google Calendar (OAuth) (backend)
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
APP_NAME=Calendar

# =========================
# Supabase (backend)
# =========================
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_TABLE_VERIFICATION_SESSIONS=verification_sessions
SUPABASE_TABLE_PENDING_RECORDS=pending_records
SUPABASE_TABLE_HISTORY_RECORDS=history_records
SUPABASE_TABLE_ADMIN_USERS=admin_users
SUPABASE_TABLE_ADMIN_SESSIONS=admin_sessions
SUPABASE_TABLE_BOOKING_HISTORY_RECORDS=booking_history_records

# =========================
# WhatsApp Cloud API (backend)
# Ative apenas quando VERIFICATION_CHANNEL=META
# =========================
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_LANGUAGE=pt_BR

# =========================
# SMS / Twilio (backend)
# Ative apenas quando VERIFICATION_CHANNEL=SMS
# =========================
SMS_TWILIO_ENABLED=false
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM_NUMBER=

# =========================
# Geoapify (backend e frontend)
# =========================
GEOAPIFY_ENABLED=true
GEOAPIFY_API_KEY=
GEOAPIFY_AUTOCOMPLETE_COUNTRY=br
GEOAPIFY_ROUTING_MODE=drive
GEOAPIFY_ROUTING_UNITS=metric
GEOAPIFY_ROUTING_LANG=pt-BR

# =========================
# Google Routes (backend)
# =========================
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ROUTES_TRAFFIC=true
GOOGLE_MAPS_ROUTES_FIELDMASK=routes.distanceMeters,routes.duration,routes.polyline.encodedPolyline

# =========================
# Banking / Extrato (admin) (backend)
# =========================
BANKING_ENABLED=true
BANKING_PROVIDER=DUMMY
FEATURES_INTER_PJ_ENABLED=false

# =========================
# Pix copia e cola (admin) (backend)
# =========================
PIX_KEY=
PIX_RECIPIENT_NAME=SG Pequenos Reparos
PIX_RECIPIENT_CITY=Belo Horizonte
PIX_DESCRIPTION=Comissao socio

# =========================
# Banco Inter PJ (backend)
# =========================
INTER_ENABLED=false
INTER_BASE_URL=
INTER_OAUTH_TOKEN_PATH=/oauth/v2/token
INTER_OAUTH_SCOPE=
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_P12_PATH=
INTER_CERT_P12_PASSWORD=
INTER_CONTA_CORRENTE=
INTER_BANKING_STATEMENT_PATH=/banking/v2/extrato
INTER_BANKING_FROM_PARAM=dataInicio
INTER_BANKING_TO_PARAM=dataFim

# =========================
# Escala 4x4 (backend)
# Disponivel em 2026-05-16, 2026-05-17, 2026-05-18 e 2026-05-19.
# =========================
APP_SCHEDULE_CYCLE_START=2026-05-16

# =========================
# Frontend (Vite)
# Em produção com Nginx reverso pode ficar vazio
# =========================
VITE_API_BASE_URL=
VITE_GEOAPIFY_PUBLIC_KEY=
VITE_ADMIN_ENABLED=true
