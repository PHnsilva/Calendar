# =========================
# Backend / Render
# =========================
SERVER_PORT=8080
APP_NAME=CalendarMate
FRONTEND_URL=https://seu-front.vercel.app
HMAC_SECRET=
ADMIN_SESSION_TTL_DAYS=7
ADMIN_BOOKING_ACTIVE_PAST_DAYS=10
ADMIN_BOOKING_MAX_FUTURE_MONTHS_AHEAD=6
APP_HISTORY_RETENTION_MONTHS=2.0
PUBLIC_BOOKING_DISABLED=false
# Fallback sem Supabase: telefone|nome|OWNER|id;telefone|nome|PROVIDER|id
# Telefones BR sao normalizados; aceita DDD + numero, com ou sem +55, espacos ou pontuacao.
# Troque os telefones dos prestadores antes de producao.
ADMIN_USERS=31995438467|SG Admin|OWNER|owner-main;31900000001|Prestador 1|PROVIDER|provider-1;31900000002|Prestador 2|PROVIDER|provider-2;31900000003|Prestador 3|PROVIDER|provider-3
SPRING_PROFILES_ACTIVE=local
DEBUG_OTP_CODE=false
DEBUG_ADMIN_ENABLED=true
DEBUG_ADMIN_PHONE=31995438467
DEBUG_ADMIN_NAME=Admin Debug
DEBUG_ADMIN_ROLE=OWNER

# =========================
# Perfil operacional
# =========================
# DUMMY | SMS | META | WHATSAPP
VERIFICATION_CHANNEL=SMS

# =========================
# Google Calendar
# =========================
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# =========================
# SMS / NotificationAPI
# =========================
SMS_NOTIFICATIONAPI_ENABLED=true
SMS_NOTIFICATIONAPI_API_KEY=
SMS_NOTIFICATIONAPI_BASE_URL=https://api.pingram.io
SMS_NOTIFICATIONAPI_TYPE=calendar_mate_otp
SMS_NOTIFICATIONAPI_MONTHLY_LIMIT=100
SMS_NOTIFICATIONAPI_USAGE_FILE=/tmp/calendarmate-sms-usage.properties

# =========================
# Meta WhatsApp Cloud API opcional
# =========================
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_LANGUAGE=pt_BR

# =========================
# Supabase histórico até 2 meses
# =========================
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_TABLE_VERIFICATION_SESSIONS=verification_sessions
SUPABASE_TABLE_PENDING_RECORDS=pending_records
SUPABASE_TABLE_HISTORY_RECORDS=history_records
SUPABASE_TABLE_ADMIN_USERS=admin_users
SUPABASE_TABLE_ADMIN_SESSIONS=admin_sessions
SUPABASE_TABLE_BOOKING_HISTORY_RECORDS=booking_history_records

# =========================
# Rotas / mapas
# Prioridade do backend: Geoapify quando habilitado; senão Google Routes.
# =========================
GEOAPIFY_ENABLED=true
GEOAPIFY_API_KEY=
GEOAPIFY_ROUTING_MODE=drive
GEOAPIFY_ROUTING_UNITS=metric
GEOAPIFY_ROUTING_LANG=pt-BR
GEOAPIFY_AUTOCOMPLETE_COUNTRY=br

GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ROUTES_TRAFFIC=true
GOOGLE_MAPS_ROUTES_FIELDMASK=routes.distanceMeters,routes.duration,routes.polyline.encodedPolyline

# =========================
# Banco Inter / extrato admin
# =========================
BANKING_ENABLED=false
BANKING_PROVIDER=DUMMY
FEATURES_INTER_PJ_ENABLED=false
INTER_ENABLED=false
INTER_BASE_URL=https://cdpj.partners.bancointer.com.br
INTER_OAUTH_TOKEN_PATH=/oauth/v2/token
INTER_OAUTH_SCOPE=extrato.read
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_P12_PATH=
INTER_CERT_P12_PASSWORD=
INTER_CONTA_CORRENTE=
INTER_BANKING_STATEMENT_PATH=/banking/v2/extrato
INTER_BANKING_FROM_PARAM=dataInicio
INTER_BANKING_TO_PARAM=dataFim

# =========================
# Pix copia e cola admin
# =========================
PIX_KEY=
PIX_RECIPIENT_NAME=SG Pequenos Reparos
PIX_RECIPIENT_CITY=Belo Horizonte
PIX_DESCRIPTION=Comissao socio

# =========================
# Escala 4x4
# Disponivel em 2026-05-16, 2026-05-17, 2026-05-18 e 2026-05-19.
